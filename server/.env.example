PORT=4300
DATABASE_URL=postgres://localhost:5432/ai_compliance_assistant
# generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile
DEFAULT_GENERATION_PROVIDER=groq
CLIENT_ORIGINS=http://localhost:5300
GENERATE_RATE_LIMIT_PER_HOUR=20
# leave unset to allow open signup; set to require this code on /auth/signup
INVITE_CODE=

# GitHub cloud connector (Phase 4) — register an OAuth App at
# https://github.com/settings/developers, set its callback URL to GITHUB_REDIRECT_URI below
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5300/api/connectors/github/callback
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONNECTOR_ENCRYPTION_KEY=
